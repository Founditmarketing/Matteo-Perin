{
  "redirects": [
    { "source": "/contact", "destination": "/enquire", "permanent": true },
    { "source": "/lifestyle", "destination": "/the-house", "permanent": true },
    { "source": "/furniture", "destination": "/casa", "permanent": true },
    { "source": "/inventory-test-hidden", "destination": "/shop", "permanent": true },
    { "source": "/inventory-test-hidden/:slug", "destination": "/shop/:slug", "permanent": true },
    { "source": "/collections/:path*", "destination": "/shop", "permanent": true },
    { "source": "/products/:slug", "destination": "/shop", "permanent": true },
    { "source": "/pages/about", "destination": "/the-house", "permanent": true }
  ],
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/((?!api/|assets/|sitemap\\.xml|robots\\.txt).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*).mp4",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*).webp",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}